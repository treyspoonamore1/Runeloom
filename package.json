{
  "name": "runeloom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Top-down spell-weaving action RPG with a chemistry-driven world.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sim.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "validate": "tsx tools/validate.ts",
    "check": "npm run typecheck && npm run lint && npm run validate && npm run test",
    "sim": "tsx tools/sim.ts",
    "bench": "tsx tools/bench.ts",
    "shots": "tsx tools/shots.ts"
  },
  "dependencies": {
    "lil-gui": "0.21.0",
    "pixi-filters": "6.1.5",
    "pixi.js": "8.22.0",
    "preact": "10.29.8",
    "@preact/signals": "2.11.3",
    "zzfx": "1.4.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
